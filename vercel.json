{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{public/**,src/views/**,src/i18n/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/accounting/cron/exchange-rates",
      "schedule": "0 1 * * *"
    }
  ]
}
