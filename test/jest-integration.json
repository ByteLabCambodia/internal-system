{
  "moduleFileExtensions": ["js", "mjs", "cjs", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".int-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "diagnostics": {
          "ignoreCodes": [151002]
        }
      }
    ],
    "^.+\\.m?js$": [
      "babel-jest",
      {
        "plugins": ["@babel/plugin-transform-modules-commonjs"]
      }
    ]
  },
  "transformIgnorePatterns": [],
  "testTimeout": 30000,
  "setupFiles": ["<rootDir>/integration/support/realm.ts"]
}
