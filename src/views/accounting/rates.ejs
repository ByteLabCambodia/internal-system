<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <div class="mb-4 grid gap-4 sm:grid-cols-3">
      <% Object.keys(current).forEach(function (currency) { %>
        <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= currency %> per USD</p>
          <p class="mt-1 text-xl font-semibold tabular text-gray-900 dark:text-white">
            <%= current[currency] !== null ? Number(current[currency]) : '—' %>
          </p>
          <% if (current[currency] === null) { %>
            <p class="mt-1 text-xs text-red-600 dark:text-red-400">No rate on file — records in this currency are refused.</p>
          <% } %>
        </div>
      <% }); %>
    </div>

    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
      <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-700 dark:text-gray-400">
          <tr>
            <th class="px-4 py-3">Date</th>
            <th class="px-4 py-3">Currency</th>
            <th class="px-4 py-3 text-right">Per USD</th>
            <th class="px-4 py-3">Source</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% if (!rows.length) { %>
            <tr><td colspan="4" class="px-4 py-6 text-center text-gray-500 dark:text-gray-400">No rates recorded yet.</td></tr>
          <% } %>
          <% rows.forEach(function (row) { %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-4 py-2.5 tabular"><%= row.rateDate %></td>
              <td class="px-4 py-2.5"><%= row.currency %></td>
              <td class="px-4 py-2.5 text-right tabular text-gray-900 dark:text-white"><%= Number(row.rateToUsd) %></td>
              <td class="px-4 py-2.5">
                <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs capitalize text-gray-600 dark:bg-gray-700 dark:text-gray-300"><%= row.source %></span>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <h2 class="mb-1 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Set a rate</h2>
    <p class="mb-4 text-sm text-gray-500 dark:text-gray-400">
      Rates are fetched daily at 01:00. A rate set here wins over the feed for that day.
    </p>

    <% if (!can['rate.override']) { %>
      <%- include('../partials/alert', { tone: 'info', message: 'Only finance and admins can override a rate.' }) %>
    <% } else { %>
      <form method="post" action="/accounting/rates">
        <%- include('../partials/csrf') %>

        <%- include('../partials/form-field', { name: 'rateDate', label: 'Date', type: 'date', value: values.rateDate, errors, required: true }) %>

        <div class="mb-4">
          <label for="currency" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Currency<span class="text-red-600"> *</span></label>
          <select id="currency" name="currency"
                  class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white">
            <% currencies.forEach(function (currency) { %>
              <option value="<%= currency %>" <%- values.currency === currency ? 'selected' : '' %>><%= currency %></option>
            <% }); %>
          </select>
        </div>

        <%- include('../partials/form-field', {
          name: 'rateToUsd', label: 'Units per 1 USD', type: 'number', step: '0.000001',
          value: values.rateToUsd, errors, required: true, hint: 'e.g. 4100 KHR per USD.',
        }) %>

        <button type="submit" class="w-full rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Save rate</button>
      </form>
    <% } %>
  </div>
</div>
