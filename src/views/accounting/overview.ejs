<div class="mb-6 grid gap-4 sm:grid-cols-3">
  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <p class="text-sm text-gray-500 dark:text-gray-400">Cash balance (1000)</p>
    <p class="mt-1 text-2xl font-semibold tabular text-gray-900 dark:text-white"><%= money.formatUsd(cashBalance) %></p>
  </div>
  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <p class="text-sm text-gray-500 dark:text-gray-400">Expense this month</p>
    <p class="mt-1 text-2xl font-semibold tabular text-gray-900 dark:text-white"><%= money.formatUsd(expenseThisMonth) %></p>
  </div>
  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <p class="text-sm text-gray-500 dark:text-gray-400">Journal entries</p>
    <p class="mt-1 text-2xl font-semibold tabular text-gray-900 dark:text-white"><%= count %></p>
  </div>
</div>

<div class="mb-4 flex flex-wrap gap-2">
  <a href="/accounting/accounts" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Chart of accounts</a>
  <a href="/accounting/rates" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Exchange rates</a>
  <a href="/reports" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Reports</a>
</div>

<form method="get" class="mb-4 flex flex-wrap items-end gap-3">
  <div>
    <label for="from" class="mb-1 block text-xs font-medium text-gray-500 dark:text-gray-400">From</label>
    <input type="date" id="from" name="from" value="<%= filters.from || '' %>"
           class="rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
  </div>
  <div>
    <label for="to" class="mb-1 block text-xs font-medium text-gray-500 dark:text-gray-400">To</label>
    <input type="date" id="to" name="to" value="<%= filters.to || '' %>"
           class="rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
  </div>
  <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Filter</button>
</form>

<% if (!entries.length) { %>
  <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
    <%- include('../partials/empty-state', {
      title: 'No journal entries yet',
      description: 'Entries are posted automatically when a payment is recorded, and manually when income is added.',
    }) %>
  </div>
<% } else { %>
  <div class="space-y-3">
    <% entries.forEach(function (entry) { %>
      <div class="overflow-hidden rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-200 px-4 py-2.5 dark:border-gray-700">
          <div>
            <span class="font-medium text-gray-900 dark:text-white"><%= entry.memo || 'Journal entry' %></span>
            <span class="ms-2 text-xs text-gray-400"><%= entry.entryDate %></span>
          </div>
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs capitalize text-gray-600 dark:bg-gray-700 dark:text-gray-300">
              <%= String(entry.source).replace(/_/g, ' ') %>
            </span>
            <% if (entry.currency !== 'USD') { %>
              <span class="text-xs text-gray-400 tabular"><%= entry.currency %> @ <%= Number(entry.exchangeRate) %></span>
            <% } %>
          </div>
        </div>
        <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
          <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
            <% (entry.lines || []).forEach(function (line) { %>
              <tr>
                <td class="px-4 py-2"><%= line.account ? line.account.code + ' ' + line.account.name : '—' %></td>
                <td class="px-4 py-2 text-right tabular text-gray-900 dark:text-white">
                  <%= Number(line.debitUsd) > 0 ? money.formatUsd(line.debitUsd) : '' %>
                </td>
                <td class="px-4 py-2 text-right tabular text-gray-900 dark:text-white">
                  <%= Number(line.creditUsd) > 0 ? money.formatUsd(line.creditUsd) : '' %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% }); %>
  </div>
  <%- include('../partials/pagination', { page: filters.page, limit: filters.limit, count, baseQuery }) %>
<% } %>
