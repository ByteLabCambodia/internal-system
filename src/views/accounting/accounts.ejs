<p class="mb-3 text-sm text-gray-500 dark:text-gray-400">
  Seeded at install. Payments debit the account resolved from the purchase order's category (C1) and credit 1000.
</p>

<div class="overflow-x-auto rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
  <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
    <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th class="px-4 py-3">Code</th>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">Type</th>
        <th class="px-4 py-3">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
      <% rows.forEach(function (row) { %>
        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
          <td class="px-4 py-2.5 font-medium tabular text-gray-900 dark:text-white"><%= row.code %></td>
          <td class="px-4 py-2.5"><%= row.name %></td>
          <td class="px-4 py-2.5 capitalize"><%= row.type %></td>
          <td class="px-4 py-2.5"><%- include('../partials/status-badge', { status: row.active ? 'confirmed' : 'cancelled' }) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
