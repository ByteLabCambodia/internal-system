<% if (sent) { %>
  <h1 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Check your email</h1>
  <%- include('../partials/alert', {
    tone: 'success',
    message: 'If that email belongs to an account, a reset link is on its way. The link can be used once and expires in an hour.',
  }) %>
  <p class="mt-5 text-center text-sm">
    <a href="/login" class="font-medium text-primary-600 hover:underline dark:text-primary-400">Back to sign in</a>
  </p>
<% } else { %>
  <h1 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Forgot password</h1>
  <p class="mb-5 text-sm text-gray-500 dark:text-gray-400">
    Enter your email and we will send you a link to choose a new password.
  </p>

  <form method="post" action="/forgot-password" x-data="{ pending: false }" @submit="pending = true">
    <%- include('../partials/csrf') %>

    <%- include('../partials/form-field', {
      name: 'email', label: 'Email', type: 'email', value: values.email,
      errors, required: true, autocomplete: 'username', autofocus: true,
    }) %>

    <button type="submit" :disabled="pending"
            class="w-full rounded-lg bg-primary-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-primary-700 focus:ring-4 focus:ring-primary-300 disabled:opacity-60 dark:focus:ring-primary-800">
      <span x-text="pending ? 'Sending…' : 'Send reset link'">Send reset link</span>
    </button>
  </form>

  <p class="mt-5 text-center text-sm">
    <a href="/login" class="font-medium text-primary-600 hover:underline dark:text-primary-400">Back to sign in</a>
  </p>
<% } %>
