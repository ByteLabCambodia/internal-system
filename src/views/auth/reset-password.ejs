<% if (tokenProblem) { %>
  <h1 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">This link no longer works</h1>
  <%- include('../partials/alert', {
    tone: 'warning',
    message: tokenProblem === 'expired'
      ? 'Password reset links expire after an hour. Request a new one and it will arrive in a moment.'
      : tokenProblem === 'used'
        ? 'This reset link has already been used. If you still need to change your password, request a new link.'
        : 'We could not recognise this reset link. Request a new one to continue.',
  }) %>
  <a href="/forgot-password"
     class="mt-2 block w-full rounded-lg bg-primary-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-primary-700">
    Request a new link
  </a>
<% } else { %>
  <h1 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">Choose a new password</h1>
  <p class="mb-5 text-sm text-gray-500 dark:text-gray-400">
    Setting a new password signs you out everywhere else.
  </p>

  <form method="post" action="/reset-password" x-data="{ pending: false }" @submit="pending = true">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="token" value="<%= token %>" />

    <%- include('../partials/password-field', {
      name: 'password', label: 'New password', errors,
      autocomplete: 'new-password', autofocus: true,
      hint: 'At least 8 characters.',
    }) %>

    <%- include('../partials/password-field', {
      name: 'passwordConfirmation', label: 'Confirm new password', errors,
      autocomplete: 'new-password',
    }) %>

    <button type="submit" :disabled="pending"
            class="w-full rounded-lg bg-primary-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-primary-700 focus:ring-4 focus:ring-primary-300 disabled:opacity-60 dark:focus:ring-primary-800">
      <span x-text="pending ? 'Saving…' : 'Save new password'">Save new password</span>
    </button>
  </form>
<% } %>
