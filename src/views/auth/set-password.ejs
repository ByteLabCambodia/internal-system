<% if (tokenProblem) { %>
  <h1 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">This invite link no longer works</h1>
  <%- include('../partials/alert', {
    tone: 'warning',
    message: tokenProblem === 'expired'
      ? 'Invite links expire after 7 days. Ask an administrator to send you a new one, or request it below.'
      : tokenProblem === 'used'
        ? 'This invite has already been used. Try signing in, or reset your password if you have forgotten it.'
        : 'We could not recognise this invite link. Ask an administrator to send a new one.',
  }) %>
  <a href="/forgot-password"
     class="mt-2 block w-full rounded-lg bg-primary-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-primary-700">
    Request a new link
  </a>
  <p class="mt-5 text-center text-sm">
    <a href="/login" class="font-medium text-primary-600 hover:underline dark:text-primary-400">Back to sign in</a>
  </p>
<% } else { %>
  <h1 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">
    <%= forced ? 'Choose a new password' : 'Set your password' %>
  </h1>
  <p class="mb-5 text-sm text-gray-500 dark:text-gray-400">
    <%= forced
      ? 'An administrator set your current password. Choose your own before continuing.'
      : 'Pick a password to finish setting up your account.' %>
  </p>

  <form method="post" action="/set-password" x-data="{ pending: false }" @submit="pending = true">
    <%- include('../partials/csrf') %>
    <% if (token) { %><input type="hidden" name="token" value="<%= token %>" /><% } %>

    <%- include('../partials/password-field', {
      name: 'password', label: 'Password', errors,
      autocomplete: 'new-password', autofocus: true,
      hint: 'At least 8 characters.',
    }) %>

    <%- include('../partials/password-field', {
      name: 'passwordConfirmation', label: 'Confirm password', errors,
      autocomplete: 'new-password',
    }) %>

    <button type="submit" :disabled="pending"
            class="w-full rounded-lg bg-primary-600 px-5 py-2.5 text-center text-sm font-medium text-white hover:bg-primary-700 focus:ring-4 focus:ring-primary-300 disabled:opacity-60 dark:focus:ring-primary-800">
      <span x-text="pending ? 'Saving…' : 'Save password'">Save password</span>
    </button>
  </form>
<% } %>
