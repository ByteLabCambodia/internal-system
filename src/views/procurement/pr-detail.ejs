<%
const actions = [];
if (pr.status === 'draft') {
  actions.push(`<form method="post" action="/purchase-requests/${pr.id}/submit">${include('../partials/csrf')}
    <button class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Submit for approval</button></form>`);
}
if (pr.status === 'pending' && can['pr.decide']) {
  actions.push(`<form method="post" action="/purchase-requests/${pr.id}/decide">${include('../partials/csrf')}
    <input type="hidden" name="decision" value="approve" />
    <button class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Approve</button></form>`);
  actions.push(`<form method="post" action="/purchase-requests/${pr.id}/decide">${include('../partials/csrf')}
    <input type="hidden" name="decision" value="reject" />
    <button class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-800 dark:text-red-400 dark:hover:bg-gray-700">Reject</button></form>`);
}
if (pr.status === 'approved' && can['po.create']) {
  actions.push(`<a href="/purchase-orders/new?prId=${pr.id}" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Create order</a>`);
}
if (['draft', 'pending', 'approved'].includes(pr.status) && can['pr.cancel']) {
  actions.push(`<button data-modal-target="cancel-pr" data-modal-toggle="cancel-pr" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Cancel request</button>`);
}
if (['draft', 'pending', 'cancelled', 'rejected'].includes(pr.status) && can['pr.delete']) {
  actions.push(`<button data-modal-target="delete-pr" data-modal-toggle="delete-pr" class="rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-800 dark:text-red-400 dark:hover:bg-gray-700">Delete</button>`);
}
%>

<%- include('../partials/page-header', {
  heading: pr.prNumber,
  status: pr.status,
  breadcrumbs: [{ label: 'Purchase Requests', href: '/purchase-requests' }, { label: pr.prNumber }],
  actionsHtml: actions.join(''),
}) %>

<div class="mb-6 rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-gray-800">
  <%- include('../partials/stepper', { steps, currentIndex: currentStep }) %>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
      <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
        <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-700 dark:text-gray-400">
          <tr>
            <th class="px-4 py-3">Item</th>
            <th class="px-4 py-3 text-right">Qty</th>
            <th class="px-4 py-3 text-right">Unit price</th>
            <th class="px-4 py-3 text-right">Line total</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
          <% pr.items.forEach(function (item) { %>
            <tr>
              <td class="px-4 py-2.5 text-gray-900 dark:text-white">
                <%= item.name %>
                <% if (item.category) { %><span class="block text-xs text-gray-400"><%= item.category %></span><% } %>
              </td>
              <td class="px-4 py-2.5 text-right tabular"><%= Number(item.qty) %></td>
              <td class="px-4 py-2.5 text-right tabular"><%= money.format(item.unitPriceOriginal, pr.currency) %></td>
              <td class="px-4 py-2.5 text-right tabular"><%= money.format(money.lineTotal(item.qty, item.unitPriceOriginal), pr.currency) %></td>
            </tr>
          <% }); %>
        </tbody>
        <tfoot class="border-t border-gray-200 dark:border-gray-700">
          <tr>
            <td colspan="3" class="px-4 py-2.5 text-right font-medium text-gray-900 dark:text-white">Total</td>
            <td class="px-4 py-2.5 text-right font-semibold text-gray-900 dark:text-white">
              <%- include('../partials/money', { amount: pr.totalOriginal, currency: pr.currency, amountUsd: pr.totalUsd, money }) %>
            </td>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Activity</h2>
      <%- include('../partials/timeline', { events }) %>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <dl class="space-y-3 text-sm">
      <div><dt class="text-gray-500 dark:text-gray-400">Requester</dt>
        <dd class="text-gray-900 dark:text-white"><%= pr.requester.firstName %> <%= pr.requester.lastName %></dd></div>
      <div><dt class="text-gray-500 dark:text-gray-400">Department</dt>
        <dd class="text-gray-900 dark:text-white"><%= pr.department ? pr.department.name : '—' %></dd></div>
      <div><dt class="text-gray-500 dark:text-gray-400">Project</dt>
        <dd class="text-gray-900 dark:text-white"><%= pr.project ? pr.project.name : '—' %></dd></div>
      <div><dt class="text-gray-500 dark:text-gray-400">Rate locked at</dt>
        <dd class="tabular text-gray-900 dark:text-white"><%= Number(pr.exchangeRate) %> <%= pr.currency %> per USD</dd></div>
      <% if (pr.approver) { %>
        <div><dt class="text-gray-500 dark:text-gray-400">Decided by</dt>
          <dd class="text-gray-900 dark:text-white"><%= pr.approver.firstName %> <%= pr.approver.lastName %>
            <span class="block text-xs text-gray-400"><%= pr.decidedAt ? new Date(pr.decidedAt).toLocaleString() : '' %></span></dd></div>
      <% } %>
      <% if (pr.note) { %>
        <div><dt class="text-gray-500 dark:text-gray-400">Note</dt>
          <dd class="whitespace-pre-line text-gray-900 dark:text-white"><%= pr.note %></dd></div>
      <% } %>
      <% if (pr.autoGenerated) { %>
        <div><dt class="text-gray-500 dark:text-gray-400">Origin</dt>
          <dd class="text-gray-900 dark:text-white">Raised automatically by the reorder rule</dd></div>
      <% } %>
    </dl>
  </div>
</div>

<%- include('../partials/modal', {
  id: 'cancel-pr',
  title: 'Cancel this purchase request?',
  bodyHtml: `<p class="mb-4 text-sm text-gray-500 dark:text-gray-400">The request stays visible with a cancelled status. This cannot be undone.</p>
    <form method="post" action="/purchase-requests/${pr.id}/cancel" class="flex justify-end gap-2">
      ${include('../partials/csrf')}
      <button type="button" data-modal-hide="cancel-pr" class="rounded-lg border border-gray-300 px-4 py-2 text-sm dark:border-gray-600 dark:text-gray-300">Keep it</button>
      <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Cancel request</button>
    </form>`,
}) %>

<%- include('../partials/modal', {
  id: 'delete-pr',
  title: 'Delete this purchase request?',
  bodyHtml: `<p class="mb-4 text-sm text-gray-500 dark:text-gray-400">This permanently removes ${pr.prNumber} and its line items. This cannot be undone.</p>
    <form method="post" action="/purchase-requests/${pr.id}/delete" class="flex justify-end gap-2">
      ${include('../partials/csrf')}
      <button type="button" data-modal-hide="delete-pr" class="rounded-lg border border-gray-300 px-4 py-2 text-sm dark:border-gray-600 dark:text-gray-300">Keep it</button>
      <button type="submit" class="rounded-lg bg-red-600 px-4 py-2 text-sm font-medium text-white hover:bg-red-700">Delete</button>
    </form>`,
}) %>
