<%
/*
 * The order is built from an approved request: choosing one prefills the lines, which
 * finance can then adjust to what was actually ordered. Supplier is an <input list> over
 * active suppliers with create-on-the-fly (C4); the expense account is prefilled by the
 * server's C1 resolution and overridable here.
 */
const options = convertible.map(function (pr) {
  return {
    id: pr.id,
    prNumber: pr.prNumber,
    currency: pr.currency,
    exchangeRate: pr.exchangeRate,
    totalOriginal: pr.totalOriginal,
    items: pr.items.map(function (item) {
      return { name: item.name, qtyOrdered: Number(item.qty), unitPrice: Number(item.unitPriceOriginal) };
    }),
  };
});
const preselected = selected ? String(selected.id) : (values.prId ? String(values.prId) : '');
%>

<% if (locals.alert) { %><%- include('../partials/alert', { tone: 'error', message: alert }) %><% } %>
<% if (errors && errors.items) { %><%- include('../partials/alert', { tone: 'error', message: errors.items }) %><% } %>

<% if (!options.length) { %>
  <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
    <%- include('../partials/empty-state', {
      title: 'No approved requests waiting',
      description: 'A purchase order is always raised from an approved purchase request, so there is nothing to convert yet.',
      action: { href: '/purchase-requests', label: 'View requests' },
    }) %>
  </div>
<% } else { %>
<form method="post" action="/purchase-orders"
      x-data='<%- JSON.stringify({ options: options, prId: preselected, items: [] }) %>'
      x-init="$watch('prId', function (id) {
                var pr = options.find(function (o) { return String(o.id) === String(id); });
                items = pr ? JSON.parse(JSON.stringify(pr.items)) : [];
              });
              prId = prId;
              var initial = options.find(function (o) { return String(o.id) === String(prId); });
              items = initial ? JSON.parse(JSON.stringify(initial.items)) : [{ name: '', qtyOrdered: 1, unitPrice: 0 }];">
  <%- include('../partials/csrf') %>

  <div class="grid gap-6 lg:grid-cols-3">
    <div class="space-y-4 lg:col-span-2">
      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <div class="mb-4">
          <label for="prId" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">
            Approved request<span class="text-red-600" aria-hidden="true"> *</span>
          </label>
          <select id="prId" name="prId" x-model="prId" required
                  class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white">
            <option value="">Choose a request…</option>
            <% options.forEach(function (option) { %>
              <option value="<%= option.id %>" <%- preselected === String(option.id) ? 'selected' : '' %>>
                <%= option.prNumber %> — <%= money.format(option.totalOriginal, option.currency) %>
              </option>
            <% }); %>
          </select>
          <% if (errors && errors.prId) { %>
            <p class="mt-1.5 text-sm text-red-600 dark:text-red-500"><%= errors.prId %></p>
          <% } else { %>
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
              The order inherits the request's currency and its locked rate. The request flips to converted.
            </p>
          <% } %>
        </div>

        <h2 class="mb-3 mt-6 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Ordered lines</h2>

        <template x-for="(item, index) in items" :key="index">
          <div class="mb-3 grid gap-2 border-b border-gray-100 pb-3 last:border-0 dark:border-gray-700 sm:grid-cols-12">
            <div class="sm:col-span-6">
              <label class="mb-1 block text-xs font-medium text-gray-500 dark:text-gray-400" :for="'po-item-name-' + index">Description</label>
              <input type="text" :id="'po-item-name-' + index" :name="'items[' + index + '][name]'" x-model="item.name" required
                     class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-medium text-gray-500 dark:text-gray-400" :for="'po-item-qty-' + index">Qty ordered</label>
              <input type="number" step="0.0001" min="0.0001" :id="'po-item-qty-' + index" :name="'items[' + index + '][qtyOrdered]'" x-model.number="item.qtyOrdered" required
                     class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-right text-sm tabular dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
            </div>
            <div class="sm:col-span-3">
              <label class="mb-1 block text-xs font-medium text-gray-500 dark:text-gray-400" :for="'po-item-price-' + index">Unit price</label>
              <input type="number" step="0.0001" min="0" :id="'po-item-price-' + index" :name="'items[' + index + '][unitPrice]'" x-model.number="item.unitPrice" required
                     class="w-full rounded-lg border border-gray-300 bg-gray-50 p-2 text-right text-sm tabular dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
            </div>
            <div class="flex items-end sm:col-span-1">
              <button type="button" @click="items.splice(index, 1)" x-show="items.length > 1"
                      class="w-full rounded-lg border border-gray-300 px-2 py-2 text-sm text-gray-500 hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-700">
                <span class="sr-only">Remove line</span>&times;
              </button>
            </div>
          </div>
        </template>

        <button type="button" @click="items.push({ name: '', qtyOrdered: 1, unitPrice: 0 })"
                class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">
          Add line
        </button>
      </div>
    </div>

    <div class="space-y-4">
      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <div class="mb-4">
          <label for="type" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Order type</label>
          <select id="type" name="type"
                  class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm capitalize dark:border-gray-600 dark:bg-gray-700 dark:text-white">
            <% types.forEach(function (type) { %>
              <option value="<%= type %>" <%- values.type === type ? 'selected' : '' %>><%= type %></option>
            <% }); %>
          </select>
        </div>

        <div class="mb-4">
          <label for="supplierName" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Supplier</label>
          <input type="text" id="supplierName" name="supplierName" list="supplier-options" value="<%= values.supplierName || '' %>"
                 class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
          <datalist id="supplier-options">
            <% suppliers.forEach(function (supplier) { %><option value="<%= supplier.name %>"></option><% }); %>
          </datalist>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
            Pick an existing supplier or type a new name — it is added to the supplier master.
          </p>
        </div>

        <div class="mb-1">
          <label for="expenseAccountId" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Expense account</label>
          <select id="expenseAccountId" name="expenseAccountId"
                  class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white">
            <option value="">Resolve from the line categories</option>
            <% expenseAccounts.forEach(function (account) { %>
              <option value="<%= account.id %>" <%- String(values.expenseAccountId) === String(account.id) ? 'selected' : '' %>>
                <%= account.code %> <%= account.name %>
              </option>
            <% }); %>
          </select>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
            Left blank: one shared category debits that category's account, a mix falls back to 6900 Misc Expense.
          </p>
        </div>
      </div>

      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between">
            <dt class="text-gray-500 dark:text-gray-400">Lines</dt>
            <dd class="tabular text-gray-900 dark:text-white" x-text="items.length"></dd>
          </div>
          <div class="flex justify-between border-t border-gray-100 pt-1 dark:border-gray-700">
            <dt class="font-medium text-gray-900 dark:text-white">Order total</dt>
            <dd class="tabular font-semibold text-gray-900 dark:text-white"
                x-text="items.reduce((sum, item) => sum + (Number(item.qtyOrdered) || 0) * (Number(item.unitPrice) || 0), 0).toFixed(2)"></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <div class="sticky bottom-0 mt-6 flex items-center justify-end gap-2 border-t border-gray-200 bg-gray-50/95 py-3 backdrop-blur dark:border-gray-700 dark:bg-gray-900/95">
    <a href="/purchase-orders" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Cancel</a>
    <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Create order</button>
  </div>
</form>
<% } %>
