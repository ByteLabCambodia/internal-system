<%
/* Choosing an order line shows what is still outstanding on it, so a claimant sees the
   ceiling before submitting rather than after the guard refuses. */
const lineOptions = lines.map(function (line) {
  return {
    id: line.id,
    label: line.name,
    poNumber: line.purchaseOrder ? line.purchaseOrder.poNumber : '',
    ordered: Number(line.qtyOrdered),
    claimed: Number(line.qtyClaimed),
    itemId: line.inventoryItem ? line.inventoryItem.id : null,
    itemName: line.inventoryItem ? line.inventoryItem.name : null,
  };
});
%>

<% if (locals.alert) { %><%- include('../partials/alert', { tone: 'error', message: alert }) %><% } %>

<% if (!lineOptions.length) { %>
  <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
    <%- include('../partials/empty-state', {
      title: 'Nothing outstanding to claim',
      description: 'Every open purchase order line has already been fully received.',
      action: { href: '/purchase-orders', label: 'View orders' },
    }) %>
  </div>
<% } else { %>
<form method="post" action="/claims" class="max-w-2xl"
      x-data='<%- JSON.stringify({ lines: lineOptions, poItemId: values.poItemId ? String(values.poItemId) : "" }) %>'>
  <%- include('../partials/csrf') %>

  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <div class="mb-4">
      <label for="poItemId" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">
        Order line<span class="text-red-600" aria-hidden="true"> *</span>
      </label>
      <select id="poItemId" name="poItemId" x-model="poItemId" required
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white">
        <option value="">Choose what arrived…</option>
        <% lineOptions.forEach(function (line) { %>
          <option value="<%= line.id %>" <%- String(values.poItemId) === String(line.id) ? 'selected' : '' %>>
            <%= line.poNumber %> — <%= line.label %> (<%= line.ordered - line.claimed %> outstanding)
          </option>
        <% }); %>
      </select>
      <% if (errors && errors.poItemId) { %>
        <p class="mt-1.5 text-sm text-red-600 dark:text-red-500"><%= errors.poItemId %></p>
      <% } %>
    </div>

    <template x-if="lines.find(l => String(l.id) === String(poItemId))">
      <p class="mb-4 rounded-lg bg-gray-50 p-3 text-sm text-gray-600 dark:bg-gray-700 dark:text-gray-300"
         x-text="(function () {
           var line = lines.find(l => String(l.id) === String(poItemId));
           return line.claimed + ' of ' + line.ordered + ' already received' +
             (line.itemName ? ' · receives into ' + line.itemName : ' · pick the catalog item below');
         })()"></p>
    </template>

    <%- include('../partials/form-field', {
      name: 'qtyClaimed', label: 'Quantity received', type: 'number', step: '0.0001',
      value: values.qtyClaimed, errors, required: true,
    }) %>

    <!-- Only needed when the order line was never linked to a catalog item. -->
    <div class="mb-4" x-show="!(lines.find(l => String(l.id) === String(poItemId)) || {}).itemId" x-cloak>
      <label for="inventoryItemId" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Receive into</label>
      <select id="inventoryItemId" name="inventoryItemId"
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white">
        <option value="">Choose a catalog item…</option>
        <% items.forEach(function (item) { %>
          <option value="<%= item.id %>" <%- String(values.inventoryItemId) === String(item.id) ? 'selected' : '' %>>
            <%= item.sku %> — <%= item.name %>
          </option>
        <% }); %>
      </select>
    </div>

    <%- include('../partials/file-upload', {
      name: 'receiptObjectKey', label: 'Delivery note or photo', prefix: 'claims',
      value: values.receiptObjectKey, enabled: storageEnabled,
    }) %>
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <a href="/claims" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Cancel</a>
    <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Submit claim</button>
  </div>
</form>

<script src="/js/r2-upload.js" defer></script>
<% } %>
