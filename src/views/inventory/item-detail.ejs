<%
const low = Number(item.stockQty) <= Number(item.reorderPoint);
const actions = can['inventory.manage']
  ? `<a href="/inventory/${item.id}/edit" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Edit</a>
     <button data-modal-target="adjust-stock" data-modal-toggle="adjust-stock" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Adjust stock</button>`
  : '';
%>

<%- include('../partials/page-header', {
  heading: item.sku + ' · ' + item.name,
  status: item.active ? (low ? 'urgent' : 'confirmed') : 'cancelled',
  breadcrumbs: [{ label: 'Inventory', href: '/inventory' }, { label: item.sku }],
  actionsHtml: actions,
}) %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <div class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">In stock</p>
        <p class="mt-1 text-2xl font-semibold tabular <%= low ? 'text-red-600 dark:text-red-400' : 'text-gray-900 dark:text-white' %>">
          <%= Number(item.stockQty) %> <span class="text-base font-normal text-gray-400"><%= item.unit %></span>
        </p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">Reorder point</p>
        <p class="mt-1 text-2xl font-semibold tabular text-gray-900 dark:text-white"><%= Number(item.reorderPoint) %></p>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
        <p class="text-sm text-gray-500 dark:text-gray-400">Reorder quantity</p>
        <p class="mt-1 text-2xl font-semibold tabular text-gray-900 dark:text-white"><%= Number(item.reorderQty) %></p>
      </div>
    </div>

    <% if (low && Number(item.reorderQty) > 0) { %>
      <%- include('../partials/alert', {
        tone: 'warning',
        message: 'At or below the reorder point. The next fulfilment against this item raises a draft reorder request automatically.',
      }) %>
    <% } %>

    <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
      <div class="border-b border-gray-200 px-4 py-3 dark:border-gray-700">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Movement history</h2>
      </div>

      <% if (!movements.length) { %>
        <%- include('../partials/empty-state', {
          title: 'No movements yet',
          description: 'Every claim, fulfilment and adjustment appends a row here with the balance it left behind.',
        }) %>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
            <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-700 dark:text-gray-400">
              <tr>
                <th class="px-4 py-3">When</th>
                <th class="px-4 py-3">Reason</th>
                <th class="px-4 py-3 text-right">Change</th>
                <th class="px-4 py-3 text-right">Balance after</th>
                <th class="px-4 py-3">By</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
              <% movements.forEach(function (movement) { %>
                <%
                  const delta = Number(movement.delta);
                  const ref = movement.refTable === 'inventory_claims' ? 'Claim #' + movement.refId
                    : movement.refTable === 'stock_requests' ? 'Request #' + movement.refId : null;
                %>
                <tr>
                  <td class="px-4 py-2.5 text-gray-500 dark:text-gray-400"><%= new Date(movement.createdAt).toLocaleString() %></td>
                  <td class="px-4 py-2.5 capitalize"><%= String(movement.reason).replace(/_/g, ' ') %>
                    <% if (ref) { %><span class="block text-xs text-gray-400"><%= ref %></span><% } %>
                  </td>
                  <td class="px-4 py-2.5 text-right tabular <%= delta > 0 ? 'text-green-600 dark:text-green-400' : 'text-red-600 dark:text-red-400' %>">
                    <%= delta > 0 ? '+' : '' %><%= delta %>
                  </td>
                  <td class="px-4 py-2.5 text-right tabular"><%= Number(movement.balanceAfter) %></td>
                  <td class="px-4 py-2.5 text-gray-500 dark:text-gray-400">
                    <%= movement.createdBy ? movement.createdBy.firstName + ' ' + movement.createdBy.lastName : 'System' %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="space-y-6">
    <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
      <dl class="space-y-3 text-sm">
        <div><dt class="text-gray-500 dark:text-gray-400">Category</dt>
          <dd class="text-gray-900 dark:text-white"><%= item.category || '—' %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-400">Unit</dt>
          <dd class="text-gray-900 dark:text-white"><%= item.unit %></dd></div>
        <div><dt class="text-gray-500 dark:text-gray-400">Added</dt>
          <dd class="text-gray-900 dark:text-white"><%= new Date(item.createdAt).toLocaleDateString() %></dd></div>
      </dl>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Activity</h2>
      <%- include('../partials/timeline', { events }) %>
    </div>
  </div>
</div>

<% if (can['inventory.manage']) { %>
  <%- include('../partials/modal', {
    id: 'adjust-stock',
    title: 'Adjust stock for ' + item.sku,
    bodyHtml: `
      <form method="post" action="/inventory/${item.id}/adjust">
        ${include('../partials/csrf')}
        <div class="mb-4">
          <label for="delta" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Change<span class="text-red-600"> *</span></label>
          <input type="number" step="0.0001" id="delta" name="delta" required
                 class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-right text-sm tabular dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Positive receives stock, negative writes it off. Current balance: ${Number(item.stockQty)}.</p>
        </div>
        <div class="mb-4">
          <label for="note" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Note</label>
          <input type="text" id="note" name="note" placeholder="Stock count correction, damage, …"
                 class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" data-modal-hide="adjust-stock" class="rounded-lg border border-gray-300 px-4 py-2 text-sm dark:border-gray-600 dark:text-gray-300">Cancel</button>
          <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Apply adjustment</button>
        </div>
      </form>`,
  }) %>
<% } %>
