<% if (locals.alert) { %><%- include('../partials/alert', { tone: 'error', message: alert }) %><% } %>

<form method="post" action="<%= editing ? '/inventory/' + editing.id : '/inventory' %>" class="max-w-2xl">
  <%- include('../partials/csrf') %>

  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <div class="grid gap-4 sm:grid-cols-2">
      <%- include('../partials/form-field', { name: 'sku', label: 'SKU', value: values.sku, errors, required: true, hint: 'Unique. Used on movement history and auto-reorder notes.' }) %>
      <%- include('../partials/form-field', { name: 'name', label: 'Name', value: values.name, errors, required: true }) %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="mb-4">
        <label for="category" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Category</label>
        <input type="text" id="category" name="category" list="category-options" value="<%= values.category || '' %>"
               class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
        <datalist id="category-options">
          <% categories.forEach(function (category) { %><option value="<%= category.name %>"></option><% }); %>
        </datalist>
        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Drives which expense account this item's spend debits.</p>
      </div>
      <%- include('../partials/form-field', { name: 'unit', label: 'Unit', value: values.unit || 'pcs', errors }) %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <%- include('../partials/form-field', {
        name: 'reorderPoint', label: 'Reorder point', type: 'number', step: '0.0001',
        value: values.reorderPoint !== undefined ? Number(values.reorderPoint) : 0, errors,
        hint: 'Fulfilling a request that lands at or below this raises a draft reorder request.',
      }) %>
      <%- include('../partials/form-field', {
        name: 'reorderQty', label: 'Reorder quantity', type: 'number', step: '0.0001',
        value: values.reorderQty !== undefined ? Number(values.reorderQty) : 0, errors,
        hint: 'Zero disables auto-reorder for this item.',
      }) %>
    </div>

    <div class="flex items-center gap-2">
      <input type="hidden" name="active" value="false" />
      <input type="checkbox" id="active" name="active" value="true" <%- (!editing || values.active) ? 'checked' : '' %>
             class="h-4 w-4 rounded border-gray-300 text-primary-600 dark:border-gray-600 dark:bg-gray-700" />
      <label for="active" class="text-sm text-gray-900 dark:text-white">Active</label>
    </div>

    <% if (editing) { %>
      <p class="mt-4 border-t border-gray-100 pt-4 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
        Stock balance is not editable here — it only moves through claims, fulfilment and manual adjustments,
        so the ledger always matches the balance.
      </p>
    <% } %>
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <a href="/inventory" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Cancel</a>
    <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">
      <%= editing ? 'Save changes' : 'Add item' %>
    </button>
  </div>
</form>
