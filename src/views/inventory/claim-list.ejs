<%- include('../partials/filter-toolbar', { statuses, filters, exportHref: '/claims/export.csv?' + baseQuery }) %>

<p class="mb-3 text-sm text-gray-500 dark:text-gray-400"><%= count %> claim<%= count === 1 ? '' : 's' %></p>

<% if (!rows.length) { %>
  <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
    <%- include('../partials/empty-state', {
      title: 'No claims yet',
      description: 'Claim goods when they arrive against a purchase order line. Stock only moves once a manager confirms it.',
      action: { href: '/claims/new', label: 'Claim goods' },
    }) %>
  </div>
<% } else { %>
  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
    <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
      <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-700 dark:text-gray-400">
        <tr>
          <th class="px-4 py-3">Item</th>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3 text-right">Qty</th>
          <th class="px-4 py-3">Claimed by</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
        <% rows.forEach(function (row) { %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-4 py-2.5 text-gray-900 dark:text-white">
              <% if (row.inventoryItem) { %>
                <a href="/inventory/<%= row.inventoryItem.id %>" class="hover:underline"><%= row.inventoryItem.name %></a>
                <span class="block text-xs text-gray-400"><%= row.inventoryItem.sku %></span>
              <% } else { %>—<% } %>
            </td>
            <td class="px-4 py-2.5">
              <% if (row.purchaseOrder) { %>
                <a href="/purchase-orders/<%= row.purchaseOrder.id %>" class="text-primary-600 hover:underline dark:text-primary-400"><%= row.purchaseOrder.poNumber %></a>
              <% } else { %>—<% } %>
            </td>
            <td class="px-4 py-2.5 text-right tabular"><%= Number(row.qtyClaimed) %></td>
            <td class="px-4 py-2.5"><%= row.claimedBy ? row.claimedBy.firstName + ' ' + row.claimedBy.lastName : '—' %>
              <span class="block text-xs text-gray-400"><%= new Date(row.createdAt).toLocaleDateString() %></span>
            </td>
            <td class="px-4 py-2.5"><%- include('../partials/status-badge', { status: row.status }) %></td>
            <td class="px-4 py-2.5 text-right">
              <% if (row.status === 'pending' && can['claim.confirm']) { %>
                <form method="post" action="/claims/<%= row.id %>/confirm" class="inline">
                  <%- include('../partials/csrf') %>
                  <button class="rounded-lg bg-primary-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-primary-700">Confirm</button>
                </form>
                <form method="post" action="/claims/<%= row.id %>/reject" class="inline">
                  <%- include('../partials/csrf') %>
                  <button class="ms-1 rounded-lg border border-gray-300 px-3 py-1.5 text-xs text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Reject</button>
                </form>
              <% } else if (row.confirmedBy) { %>
                <span class="text-xs text-gray-400"><%= row.confirmedBy.firstName %> <%= row.confirmedBy.lastName %></span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/pagination', { page: filters.page, limit: filters.limit, count, baseQuery }) %>
<% } %>
