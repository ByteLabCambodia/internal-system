<%
const itemOptions = items.map(function (item) {
  return { id: item.id, label: item.sku + ' — ' + item.name, stock: Number(item.stockQty), unit: item.unit };
});
%>

<form method="post" action="/stock-requests" class="max-w-2xl"
      x-data='<%- JSON.stringify({ items: itemOptions, inventoryItemId: values.inventoryItemId ? String(values.inventoryItemId) : "" }) %>'>
  <%- include('../partials/csrf') %>

  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <div class="mb-4">
      <label for="inventoryItemId" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">
        Item<span class="text-red-600" aria-hidden="true"> *</span>
      </label>
      <select id="inventoryItemId" name="inventoryItemId" x-model="inventoryItemId" required
              class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white">
        <option value="">Choose an item…</option>
        <% itemOptions.forEach(function (item) { %>
          <option value="<%= item.id %>" <%- String(values.inventoryItemId) === String(item.id) ? 'selected' : '' %>><%= item.label %></option>
        <% }); %>
      </select>
      <% if (errors && errors.inventoryItemId) { %>
        <p class="mt-1.5 text-sm text-red-600 dark:text-red-500"><%= errors.inventoryItemId %></p>
      <% } else { %>
        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400" x-cloak
           x-text="(function () {
             var item = items.find(i => String(i.id) === String(inventoryItemId));
             return item ? item.stock + ' ' + item.unit + ' on hand' : '';
           })()"></p>
      <% } %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <%- include('../partials/form-field', {
        name: 'qty', label: 'Quantity', type: 'number', step: '0.0001',
        value: values.qty, errors, required: true,
      }) %>

      <div class="mb-4">
        <label for="priority" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Priority</label>
        <select id="priority" name="priority"
                class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm capitalize dark:border-gray-600 dark:bg-gray-700 dark:text-white">
          <% priorities.forEach(function (priority) { %>
            <option value="<%= priority %>" <%- (values.priority || 'medium') === priority ? 'selected' : '' %>><%= priority %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="mb-4">
      <label for="department" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Department</label>
      <input type="text" id="department" name="department" list="department-options" value="<%= values.department || '' %>"
             class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white" />
      <datalist id="department-options">
        <% departments.forEach(function (department) { %><option value="<%= department.name %>"></option><% }); %>
      </datalist>
    </div>

    <div>
      <label for="note" class="mb-1.5 block text-sm font-medium text-gray-900 dark:text-white">Note</label>
      <textarea id="note" name="note" rows="3"
                class="block w-full rounded-lg border border-gray-300 bg-gray-50 p-2.5 text-sm dark:border-gray-600 dark:bg-gray-700 dark:text-white"><%= values.note || '' %></textarea>
    </div>
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <a href="/stock-requests" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Cancel</a>
    <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">Submit request</button>
  </div>
</form>
