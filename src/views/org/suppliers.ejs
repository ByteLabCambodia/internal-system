<div class="grid gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <p class="mb-3 text-sm text-gray-500 dark:text-gray-400"><%= rows.length %> supplier<%= rows.length === 1 ? '' : 's' %></p>

    <% if (!rows.length) { %>
      <div class="rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
        <%- include('../partials/empty-state', {
          title: 'No suppliers yet',
          description: 'Suppliers are added here or created on the fly from the purchase order form.',
        }) %>
      </div>
    <% } else { %>
      <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
        <table class="w-full text-left text-sm text-gray-600 dark:text-gray-300">
          <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500 dark:bg-gray-700 dark:text-gray-400">
            <tr>
              <th class="px-4 py-3">Name</th>
              <th class="px-4 py-3">Contact</th>
              <th class="px-4 py-3 text-right">Terms</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            <% rows.forEach(function (row) { %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-4 py-2.5 font-medium text-gray-900 dark:text-white"><%= row.name %>
                  <% if (row.bankAccount) { %><span class="block text-xs text-gray-400"><%= row.bankAccount %></span><% } %>
                </td>
                <td class="px-4 py-2.5"><%= row.contactName || '—' %>
                  <% if (row.phone || row.email) { %>
                    <span class="block text-xs text-gray-400"><%= [row.phone, row.email].filter(Boolean).join(' · ') %></span>
                  <% } %>
                </td>
                <td class="px-4 py-2.5 text-right tabular"><%= row.paymentTermsDays !== null ? row.paymentTermsDays + ' days' : '—' %></td>
                <td class="px-4 py-2.5"><%- include('../partials/status-badge', { status: row.active ? 'confirmed' : 'cancelled' }) %></td>
                <td class="px-4 py-2.5 text-right">
                  <a href="/admin/suppliers/<%= row.id %>/edit" class="text-primary-600 hover:underline dark:text-primary-400">Edit</a>
                  <form method="post" action="/admin/suppliers/<%= row.id %>/delete" class="inline">
                    <%- include('../partials/csrf') %>
                    <button class="ms-2 text-gray-400 hover:text-red-600 hover:underline">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
    <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
      <%= editing ? 'Edit supplier' : 'Add supplier' %>
    </h2>

    <form method="post" action="<%= editing ? '/admin/suppliers/' + editing.id : '/admin/suppliers' %>">
      <%- include('../partials/csrf') %>

      <%- include('../partials/form-field', { name: 'name', label: 'Name', value: values.name, errors, required: true }) %>
      <%- include('../partials/form-field', { name: 'contactName', label: 'Contact name', value: values.contactName, errors }) %>
      <%- include('../partials/form-field', { name: 'phone', label: 'Phone', value: values.phone, errors }) %>
      <%- include('../partials/form-field', { name: 'email', label: 'Email', type: 'email', value: values.email, errors }) %>
      <%- include('../partials/form-field', { name: 'bankAccount', label: 'Bank account', value: values.bankAccount, errors }) %>
      <%- include('../partials/form-field', {
        name: 'paymentTermsDays', label: 'Payment terms (days)', type: 'number',
        value: values.paymentTermsDays, errors,
      }) %>

      <div class="mb-4 flex items-center gap-2">
        <input type="hidden" name="active" value="false" />
        <input type="checkbox" id="active" name="active" value="true" <%- (!editing || values.active) ? 'checked' : '' %>
               class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700" />
        <label for="active" class="text-sm text-gray-900 dark:text-white">Active</label>
      </div>

      <div class="flex gap-2">
        <button type="submit" class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">
          <%= editing ? 'Save changes' : 'Add supplier' %>
        </button>
        <% if (editing) { %>
          <a href="/admin/suppliers" class="rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-700">Cancel</a>
        <% } %>
      </div>
    </form>
  </div>
</div>
